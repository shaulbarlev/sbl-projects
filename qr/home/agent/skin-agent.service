# The home end of the sbl.cx traffic light. Install:
#   cp skin-agent.py /opt/skin-agent/ ; cp skin-agent.service /etc/systemd/system/
#   write /etc/skin-agent.env (mode 600): SKIN_URL, AGENT_TOKEN, HA_URL, WEBHOOK_SET, WEBHOOK_REPORT, WEBHOOK_SWITCH
#   systemctl enable --now skin-agent
[Unit]
Description=sbl.cx home agent (traffic light)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/skin-agent.env
ExecStart=/usr/bin/python3 /opt/skin-agent/skin-agent.py
Restart=always
RestartSec=3
DynamicUser=yes
# The player ledger lives here: /var/lib/skin-agent, created and chowned to
# the dynamic user by systemd, and kept across restarts.
StateDirectory=skin-agent
# The ledger holds other people's addresses: not world-readable.
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
# No SystemCallFilter: python under an LXC trips it (SIGSYS).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
