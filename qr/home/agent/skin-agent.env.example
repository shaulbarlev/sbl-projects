# /etc/skin-agent.env — mode 600, root-owned. Never commit the real file.
SKIN_URL=wss://sbl.cx/_/agent
AGENT_TOKEN=the AGENT_TOKEN secret set on the Worker with `wrangler secret put AGENT_TOKEN`
HA_URL=http://192.168.50.232:8123
WEBHOOK_SET=id of the "set a lamp" webhook (see homeassistant/automations/set-a-lamp.yaml)
WEBHOOK_REPORT=id of the "report lamp state" webhook (see homeassistant/automations/report-lamp-state.yaml)
WEBHOOK_SWITCH=id of the webhook that mirrors the master switch into Home Assistant
